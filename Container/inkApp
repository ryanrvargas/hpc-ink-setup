#!/bin/bash
set -euo pipefail

INKLY_DIR="$HOME/.inkly"
IMAGE="$INKLY_DIR/inkly1.sif"
COPILOT_STATE="$INKLY_DIR/copilot"

mkdir -p "$COPILOT_STATE"
chmod 700 "$COPILOT_STATE"

if [ ! -f "$IMAGE" ]; then
  echo "Inkly container not found at $IMAGE" >&2
  exit 1
fi

exec apptainer exec \
  --containall \
  --cleanenv \
  --no-home \
  --writable-tmpfs \
  --bind "$COPILOT_STATE:/opt/inkhome/.config/.copilot" \
  "$IMAGE" \
  ink "$@"
