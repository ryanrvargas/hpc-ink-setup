Bootstrap: docker
From: ubuntu:22.04

%labels
    Author "Ryan"
    Description "Fully isolated Inkly container with Ubuntu and install.sh executed at build time"

%environment
    export HOME=/opt/inkhome
    export PATH=/opt/inkhome/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
    export NVM_DIR=/opt/inkhome/.nvm

%post
    set -eux

    echo "=== Updating base system ==="
    apt-get update -y
    apt-get install -y --no-install-recommends \
        curl wget git nano bash ca-certificates gnupg build-essential python3 python3-pip

    echo "=== Creating isolated HOME inside container ==="
    mkdir -p /opt/inkhome
    chmod -R 777 /opt/inkhome

    # Make sure install.sh sees the right HOME and NVM_DIR
    export HOME=/opt/inkhome
    export NVM_DIR=/opt/inkhome/.nvm

    echo "=== Copying install.sh ==="
    cp /tmp/install.sh /opt/install.sh
    chmod +x /opt/install.sh

    echo "=== Running install.sh inside container ==="
    cd /opt
    bash /opt/install.sh

    echo "=== Cleaning up ==="
    apt-get clean
    rm -rf /var/lib/apt/lists/*


%files
    ./install.sh /tmp/install.sh

%runscript
    exec bash
