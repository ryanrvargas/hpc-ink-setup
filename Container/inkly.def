Bootstrap: docker
From: ubuntu:22.04

%labels
    Author Inkly
    Version 0.1.0

%environment
    # Make baked-in inkly importable
    export PYTHONPATH=/opt/inkly:$PYTHONPATH

    # Default locations (can be overridden by inkApp via --env)
    export INKLY_HOME_OVERRIDE=${INKLY_HOME_OVERRIDE:-/host_inkly}
    export COPILOT_CONFIG_DIR=${COPILOT_CONFIG_DIR:-/host_copilot}

%post
    set -eux

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl git python3 python3-venv python3-pip \
        bash coreutils jq
    rm -rf /var/lib/apt/lists/*

    # ---- Node 20 + Copilot CLI ----
    # Use NodeSource to get Node 20 on Ubuntu 22.04.
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get update
    apt-get install -y --no-install-recommends nodejs
    apt-get install -y python3-pip
    pip3 install tomli
    rm -rf /var/lib/apt/lists/*

    npm install -g @github/copilot

    # ---- Inkly runtime ----
    mkdir -p /opt/inkly
    chmod 755 /opt/inkly

    # Put entrypoint on PATH
    chmod 755 /usr/local/bin

%files
    # Copy Inkly runtime package into image
    ../inkly /opt/inkly/inkly

    # Copy thin wrapper into image
    ../ink /usr/local/bin/ink

%runscript
    # Default run: ink (interactive) or ink "prompt"
    exec ink "$@"
